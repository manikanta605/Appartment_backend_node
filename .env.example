PORT=3000

# Database Engine ('sqlite' or 'postgres')
DB_DIALECT=sqlite
DB_STORAGE=./residex.sqlite

# PostgreSQL Configuration (used if DB_DIALECT=postgres)
DB_NAME=apartment_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

JWT_SECRET=supersecretkey123
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Firebase Cloud Messaging (FCM)
# Place serviceAccountKey.json in backend/config/serviceAccountKey.json
# Or specify absolute path:
FIREBASE_SERVICE_ACCOUNT=./config/serviceAccountKey.json
